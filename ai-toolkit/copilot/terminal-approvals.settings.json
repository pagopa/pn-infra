{
  "chat.tools.terminal.blockDetectedFileWrites": "all",
  "chat.tools.terminal.ignoreDefaultAutoApproveRules": false,
  "chat.tools.terminal.autoApproveWorkspaceNpmScripts": false,
  "chat.tools.terminal.autoApprove": {
    "pwd": true,
    "ls": true,
    "tree": true,
    "grep": true,
    "rg": true,
    "cat": true,
    "head": true,
    "tail": true,
    "cp": false,
    "mv": false,
    "rm": false,
    "rmdir": false,
    "del": false,
    "erase": false,
    "delete": false,
    "bash": false,
    "sh": false,
    "zsh": false,
    "fish": false,
    "node": false,
    "python": false,
    "python3": false,
    "eval": false,
    "xargs": false,
    "/^tree\\b.*\\s-[^\\s]*o/": false,
    "/^rg\\b.*\\s--(pre|hostname-bin)(\\s|=|$)/": false,
    "/[<>`$]/": {
      "approve": false,
      "matchCommandLine": true
    }
  }
}
